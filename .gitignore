# Ignores installed npm packages because they can be restored with npm install.
node_modules/

# Ignores generated production builds.
dist/

# Ignores test coverage reports.
coverage/

# Ignores Vite's temporary cache.
.vite/

# Ignores dependency folders generated by Composer.
vendor/

# Ignores local environment files that may contain secrets.
.env
.env.*
!.env.example

# Ignores debug and package-manager log files.
*.log

# Ignores common editor and operating-system files.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Composer lock files are normally not committed for reusable libraries.
packages/laravel/composer.lock

# Ignores PHPUnit's generated cache.
.phpunit.cache/
.phpunit.result.cache
